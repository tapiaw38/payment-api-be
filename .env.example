# MercadoPago Configuration
MP_PUBLIC_KEY_AR=your_mercadopago_public_key_here
MP_ACCESS_TOKEN=your_mercadopago_access_token_here
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here
MP_SUBSCRIPTION_WEBHOOK_URL=https://payments.example.com/api/v1/webhooks/mercadopago

# Database Configuration (overridden by docker-compose environment)
DATABASE_URL=postgresql://payments:payments@payments-postgres-db:5432/payments

# Environment
ENVIRONMENT=dev

# API access. One key per calling product: the key says who is asking and
# decides which tenant's rows the request can see.
# The service refuses to serve if neither variable is set.
PAYMENTS_API_KEYS=practiq:change-me,yego:change-me
# Single-product deployments may keep using this; it maps to tenant "default".
# PAYMENTS_API_KEY=change-me
